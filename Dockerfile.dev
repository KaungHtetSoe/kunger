FROM rust:latest

# Install system dependencies for Tauri and CLI testing
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    libdbus-1-dev \
    libgtk-3-dev \
    libsqlite3-dev \
    libwebkit2gtk-4.1-dev \
    libsoup-3.0-dev \
    libjavascriptcoregtk-4.1-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /kunger

# Create .dockerignore to avoid copying huge files
RUN echo "target" > .dockerignore && \
    echo ".git" >> .dockerignore && \
    echo "node_modules" >> .dockerignore

# Copy only source files and configs (not target directory)
COPY Cargo.* ./
COPY src-tauri ./src-tauri
COPY docs ./docs

# Set the default command - tests will build on demand
CMD ["bash"]
